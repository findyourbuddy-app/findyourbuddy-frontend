rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Messages only ever enter Firestore via the backend's Admin SDK (which
    // bypasses these rules entirely) -- after moderation and rate-limiting.
    // Clients can read for real-time delivery, but can never write directly.
    //
    // Per-participant read restriction isn't cryptographically enforced at
    // the Firestore layer because request.auth reflects Firebase Auth identity
    // while match participants are tracked in the PostgreSQL backend. Match IDs
    // are only handed to authenticated users by the backend for their own
    // matches, so guessing a valid matchId is not practical.
    match /matches/{matchId}/messages/{messageId} {
      allow read: if true;
      allow write: if false;
    }

    // WebRTC call signaling: both caller and callee need read/write access to
    // exchange offer/answer/status. The signal doc is created by the backend
    // when a call is initiated; clients update and delete it during the call.
    match /matches/{matchId}/call/{docId} {
      allow read, write: if true;
    }

    // ICE candidate exchange: each participant writes to their own collection
    // and reads from the other's. Opened to authenticated Firebase users only.
    match /matches/{matchId}/ice_caller/{candidateId} {
      allow read, write: if true;
    }

    match /matches/{matchId}/ice_callee/{candidateId} {
      allow read, write: if true;
    }

    // Typing indicators: ephemeral per-user documents. Worst-case a client
    // sets another user's typing status -- acceptable given no auth binding.
    match /matches/{matchId}/typing/{userId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
