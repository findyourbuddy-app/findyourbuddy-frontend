# Backend API adresi. Dev'de boş bırakılabilir: LAN IP'si Expo hostUri'den
# otomatik algılanır (port 8001). Production build'de ZORUNLU,
# örn. https://api.findyourbuddy.dev
EXPO_PUBLIC_API_BASE_URL=

EXPO_PUBLIC_FIREBASE_API_KEY=kendi_firebase_keyiniz
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=kendi_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=kendi_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=kendi_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=kendi_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=kendi_app_id

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=kendi_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=kendi_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=kendi_android_client_id.apps.googleusercontent.com

EXPO_PUBLIC_GIPHY_API_KEY=kendi_giphy_api_keyiniz