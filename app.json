{
  "expo": {
    "name": "FindYourBuddy",
    "slug": "findyourbuddy-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.findyourbuddy.app"
    },
    "android": {
      "package": "com.findyourbuddy.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_GOOGLE_MAPS_ANDROID_API_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF6E9",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafı seçebilmek için galeriye erişim izni gerekiyor."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sana yakın etkinlikleri gösterebilmek için konumuna erişim izni gerekiyor."
        }
      ],
      "expo-notifications",
      "expo-audio"
    ]
  }
}
